<Window x:Class="AirDesk.Host.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AirDesk Host · Phase 2" Height="920" Width="1080" MinHeight="650" MinWidth="850" Background="#081628" Foreground="#E6EEFF" WindowStartupLocation="CenterScreen" Closing="OnClosing">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <TextBlock Text="AirDesk Host" FontSize="29" Foreground="#C7BCFF"/>
  <TextBlock Margin="0,5,0,12" Text="보안 페어링 · 세션 승인 · 모의 입력 진단"/>
  <Border Background="#3D2D22" Padding="12" CornerRadius="8"><TextBlock TextWrapping="Wrap" Text="실제 Windows 입력 잠금: 차량 안전 증거 UNKNOWN · Native 권한 발급 불가. 모의 입력은 OS 입력을 실행하지 않습니다." Foreground="#FFCA7B"/></Border>
  <WrapPanel Margin="0,14,0,10">
   <Button x:Name="StartButton" Content="보안 Host 시작" Click="OnStart" Padding="12,8" Margin="0,0,10,0"/>
   <Button Content="Host 중지" Click="OnStop" Padding="12,8" Margin="0,0,10,0"/>
   <TextBlock x:Name="StatusText" Text="DISCONNECTED · Host 중지됨" VerticalAlignment="Center"/>
  </WrapPanel>
  <TextBlock Text="1. 공개 인증서 확인 및 장치 등록" FontSize="18" Margin="0,6"/>
  <TextBlock TextWrapping="Wrap" Text="Android 앱의 ‘장치 공개 정보’를 아래에 붙여 넣고, 양쪽 화면의 전체 SHA-256 지문을 대조한 뒤 등록하세요. 공개 인증서만 교환하며 코드나 개인키는 이 정보에 포함되지 않습니다."/>
  <TextBox x:Name="DeviceImport" Height="75" Margin="0,7" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Android에서 확인한 전체 지문" VerticalAlignment="Center" Margin="0,0,10,0"/>
   <TextBox Grid.Column="1" x:Name="ConfirmedFingerprint" Margin="0,0,10,0"/>
   <Button Grid.Column="2" Content="지문 확인 · 장치 등록" Click="OnEnroll" Padding="10,7"/>
  </Grid>
  <TextBlock Text="Host 인증서 SHA-256 (Android와 전체 값 비교)" Margin="0,10,0,3"/>
  <TextBox x:Name="HostFingerprint" IsReadOnly="True"/>
  <TextBlock Text="2. 일회용 페어링 코드와 연결 정보" FontSize="18" Margin="0,18,0,6"/>
  <WrapPanel>
   <Button Content="새 8자리 코드 표시" Click="OnBeginPairing" Padding="10,7" Margin="0,0,10,0"/>
   <Button Content="페어링 취소" Click="OnCancelPairing" Padding="10,7" Margin="0,0,10,0"/>
   <Button Content="공개 연결 정보 복사" Click="OnCopyBootstrap" Padding="10,7"/>
  </WrapPanel>
  <TextBlock x:Name="PairingCode" Text="코드 없음" FontSize="30" Foreground="#9FDDB8" Margin="0,8"/>
  <TextBlock x:Name="PairingStatus" Text="PC 화면에서만 코드를 확인하세요. 유효 시간 120초." TextWrapping="Wrap"/>
  <WrapPanel Margin="0,8"><Button Content="요청 장치 페어링 허용" Click="OnAllowPairing" Padding="10,7" Margin="0,0,10,0"/><Button Content="페어링 거부" Click="OnDenyPairing" Padding="10,7"/></WrapPanel>
  <TextBlock Text="3. 연결 장치 · 세션 · 입력 권한" FontSize="18" Margin="0,12,0,6"/>
  <ListBox x:Name="DeviceList" Height="125"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3">
   <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding Fingerprint}" FontSize="11"/>
   <TextBlock><Run Text="Paired: "/><Run Text="{Binding Paired}"/><Run Text="  Revoked: "/><Run Text="{Binding Revoked}"/></TextBlock>
  </StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
  <Button Content="선택 장치 연결 해제 · 등록 철회" Click="OnRevokeDevice" HorizontalAlignment="Left" Padding="10,7" Margin="0,7"/>
  <TextBlock x:Name="SessionStatus" Text="세션 요청 없음" TextWrapping="Wrap"/>
  <WrapPanel Margin="0,8"><Button Content="요청 세션 · 모의 입력 권한 승인" Click="OnApproveSession" Padding="10,7" Margin="0,0,10,0"/><Button Content="세션 거부" Click="OnDenySession" Padding="10,7" Margin="0,0,10,0"/><Button Content="세션 종료 · 입력 해제" Click="OnEndSession" Padding="10,7"/></WrapPanel>
  <TextBlock Text="모의 입력 대상 모니터 (변경 시 세션 철회)" Margin="0,7,0,3"/>
  <ComboBox x:Name="DisplayList" DisplayMemberPath="Label" SelectionChanged="OnDisplayChanged"/>
  <Border Background="#162842" Padding="12" CornerRadius="8" Margin="0,12"><StackPanel>
   <TextBlock Text="MOCK ONLY · 실제 입력 잠금" Foreground="#FFCA7B" FontSize="17"/>
   <TextBlock x:Name="InputStatus" Text="모의 이벤트 0 · 눌린 버튼 0 · 눌린 키 0 · Native 호출 0" Margin="0,7,0,0"/>
   <TextBlock Text="키보드 문자열과 키 입력 내역은 저장하거나 표시하지 않습니다." Foreground="#9EB1D7" Margin="0,5,0,0"/>
  </StackPanel></Border>
  <TextBlock Text="진단 Python 채널 8765와 독립 · 새 보안 채널은 같은 PC의 loopback 8766만 사용 · 화면 스트리밍은 미구현" Foreground="#9EB1D7" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer>
</Window>
