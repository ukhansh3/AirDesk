{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AirDesk Diagnostic Control",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "type",
    "sessionId",
    "sequence",
    "timestampMs",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1"
    },
    "type": {
      "enum": [
        "auth.hello",
        "auth.accepted",
        "auth.rejected",
        "heartbeat",
        "session.locked",
        "session.closed"
      ]
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestampMs": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "auth.hello"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "token"
          ],
          "properties": {
            "token": {
              "type": "string",
              "minLength": 24,
              "maxLength": 512
            }
          }
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "auth.accepted"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "diagnostic_only"
            }
          }
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "auth.rejected"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "errorCode"
          ],
          "properties": {
            "errorCode": {
              "enum": [
                "UNAUTHENTICATED",
                "INVALID_VERSION",
                "RATE_LIMITED"
              ]
            }
          }
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "heartbeat"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lastReceivedSequence"
          ],
          "properties": {
            "lastReceivedSequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          }
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "session.locked"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "enum": [
                "UNSAFE_VEHICLE",
                "AUTH_REVOKED",
                "APP_BACKGROUND",
                "STALE_HEARTBEAT",
                "NETWORK_FAILURE"
              ]
            }
          }
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "session.closed"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "enum": [
                "USER_REQUEST",
                "EXPIRED",
                "ERROR",
                "REVOKED",
                "SAFETY_LOCK"
              ]
            }
          }
        }
      },
      "required": [
        "type",
        "payload"
      ]
    }
  ]
}
