{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PROPOSED authenticated session control messages; not yet implemented",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "type",
    "sessionId",
    "sequence",
    "timestampMs",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1"
    },
    "type": {
      "enum": [
        "session.request",
        "session.approve",
        "session.granted",
        "session.heartbeat",
        "session.revoke",
        "session.ended"
      ]
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestampMs": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "session.request"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connectionId",
            "capabilities"
          ],
          "properties": {
            "connectionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9._-]+$"
            },
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "VIEW_VIDEO",
                  "POINTER",
                  "KEYBOARD"
                ]
              }
            }
          }
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "session.approve"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestId",
            "approved",
            "expiresAtMs"
          ],
          "properties": {
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9._-]+$"
            },
            "approved": {
              "type": "boolean"
            },
            "expiresAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "session.granted"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grantId",
            "capabilities",
            "expiresAtMs"
          ],
          "properties": {
            "grantId": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            },
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "VIEW_VIDEO",
                  "POINTER",
                  "KEYBOARD"
                ]
              }
            },
            "expiresAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "session.heartbeat"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ackSequence"
          ],
          "properties": {
            "ackSequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          }
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "session.revoke"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "enum": [
                "USER_REQUEST",
                "SAFETY_LOCK",
                "AUTH_REVOKED",
                "TIMEOUT",
                "REMOTE_DISCONNECT",
                "ERROR"
              ]
            }
          }
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "session.ended"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "enum": [
                "USER_REQUEST",
                "SAFETY_LOCK",
                "AUTH_REVOKED",
                "TIMEOUT",
                "REMOTE_DISCONNECT",
                "ERROR"
              ]
            }
          }
        }
      },
      "required": [
        "type",
        "payload"
      ]
    }
  ]
}
