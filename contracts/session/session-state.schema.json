{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AirDesk local UI session projection; status is not authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "safety",
    "hostApproved",
    "updatedAtMs",
    "foreground",
    "authVerified",
    "heartbeatFresh",
    "uxAllowed"
  ],
  "properties": {
    "sessionId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "state": {
      "enum": [
        "DISCONNECTED",
        "PAIRING",
        "WAITING_APPROVAL",
        "CONNECTED",
        "LOCKED",
        "ERROR"
      ]
    },
    "safety": {
      "enum": [
        "UNKNOWN",
        "PARKED_CONFIRMED",
        "DRIVING",
        "UX_RESTRICTED",
        "UNSUPPORTED"
      ]
    },
    "hostApproved": {
      "type": "boolean"
    },
    "updatedAtMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "foreground": {
      "type": "boolean"
    },
    "authVerified": {
      "type": "boolean"
    },
    "heartbeatFresh": {
      "type": "boolean"
    },
    "uxAllowed": {
      "type": "boolean"
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    }
  }
}
