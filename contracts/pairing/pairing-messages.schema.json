{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PROPOSED mutually-approved pairing messages; not yet implemented",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "type",
    "sessionId",
    "sequence",
    "timestampMs",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1"
    },
    "type": {
      "enum": [
        "pairing.begin",
        "pairing.offer",
        "pairing.claim",
        "pairing.approval",
        "pairing.completed",
        "pairing.revoked"
      ]
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestampMs": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "pairing.begin"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deviceLabel"
          ],
          "properties": {
            "deviceLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "pairing.offer"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pairingId",
            "expiresAtMs",
            "code"
          ],
          "properties": {
            "pairingId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9._-]+$"
            },
            "expiresAtMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "code": {
              "type": "string",
              "pattern": "^[0-9]{8}$"
            }
          }
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "pairing.claim"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pairingId",
            "code",
            "deviceLabel"
          ],
          "properties": {
            "pairingId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9._-]+$"
            },
            "code": {
              "type": "string",
              "pattern": "^[0-9]{8}$"
            },
            "deviceLabel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "pairing.approval"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pairingId",
            "side",
            "approved"
          ],
          "properties": {
            "pairingId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9._-]+$"
            },
            "side": {
              "enum": [
                "HOST",
                "VEHICLE"
              ]
            },
            "approved": {
              "type": "boolean"
            }
          }
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "pairing.completed"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pairingId",
            "connectionId"
          ],
          "properties": {
            "pairingId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9._-]+$"
            },
            "connectionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9._-]+$"
            }
          }
        }
      },
      "required": [
        "type",
        "payload"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "pairing.revoked"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pairingId",
            "reason"
          ],
          "properties": {
            "pairingId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9._-]+$"
            },
            "reason": {
              "enum": [
                "USER_REQUEST",
                "EXPIRED",
                "REPLACED",
                "AUTH_FAILURE",
                "SECURITY_POLICY"
              ]
            }
          }
        }
      },
      "required": [
        "type",
        "payload"
      ]
    }
  ]
}
